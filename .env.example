# Copy to .env and fill in as needed. Every var here has a working default or
# auto-detects -- .env is optional for a standard sibling-repo install.

# --- Scriptlet depot ---
# Path to the autohotkey-tools checkout. Auto-detected as a sibling of this
# repo (../autohotkey-tools) when unset -- see src/autohotkey_mcp/depot.py.
# AUTOHOTKEY_SCRIPT_DEPOT=D:/Dev/repos/autohotkey-tools

# ScriptletCOMBridge base URL (autohotkey-tools' HTTP bridge). Falls back to
# direct depot scan + subprocess AHK launch when the bridge isn't reachable.
AUTOHOTKEY_BRIDGE_URL=http://127.0.0.1:10764

# --- AutoHotkey executable (direct-run fallback, no bridge) ---
# Auto-detected under Program Files when unset.
# AUTOHOTKEY_EXE=C:/Program Files/AutoHotkey/v2/AutoHotkey64.exe
# AHK_PATH=

# --- AI generation (generate_scriptlet / refine_ahk_prompt) ---
# Primary path is FastMCP sampling (no config needed, works when the MCP
# host -- Cursor, Claude Desktop -- exposes ctx.sample()). These are only
# used as the localhost-HTTP fallback (Ollama, LM Studio, etc.):
# AUTOHOTKEY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AUTOHOTKEY_LLM_MODEL=llama3.1
# AUTOHOTKEY_LLM_API_KEY=
# AUTOHOTKEY_LLM_TIMEOUT=60
# OPENAI_API_KEY=

# --- Sibling autohotkey-linter (used by scriptlet_ops operation='promote') ---
# Auto-detected as ../autohotkey-linter/ahk_lint.py when unset.
# AHK_LINTER_PATH=D:/Dev/repos/autohotkey-linter/ahk_lint.py

# --- Server ---
PORT=10746
HOST=127.0.0.1
# AUTOHOTKEY_MCP_HTTP=1

# --- Optional features ---
AUTOHOTKEY_PREFAB_APPS=1
# AUTOHOTKEY_SKILLS_DIR=.cursor/skills
